@model IEnumerable<EventEase.Models.Event>

@{
    ViewData["Title"] = "Event List";
}

<link href="https://fonts.googleapis.com/css2?family=Lato&family=Arimo&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Arimo', sans-serif;
        background-color: #f0fff0;
        color: #333;
        padding: 20px;
    }

    h1 {
        font-family: 'Lato', sans-serif;
        font-size: 2.5rem;
        margin-bottom: 20px;
        color: #2F4F2F;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    th {
        font-family: 'Lato', sans-serif;
        background-color: #7CFC00;
        color: black;
        padding: 10px;
        text-align: left;
    }

    td {
        font-family: 'Arimo', sans-serif;
        padding: 10px;
        border-bottom: 1px solid #ddd;
    }

    tr:hover {
        background-color: #e0ffe0;
    }

    .btn-azure {
        display: inline-block;
        padding: 10px 20px;
        margin: 2px;
        background-color: #7CFC00;
        color: black;
        border: none;
        font-family: 'Lato', sans-serif;
        font-weight: bold;
        border-radius: 5px;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
    }

        .btn-azure:hover {
            background-color: #32CD32;
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }

    .filter-form {
        background-color: white;
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
    }
</style>

<h1>Event</h1>

<!-- Filter Form -->
<form method="get" asp-action="Index" class="filter-form">

    <!-- Event Type -->
    <label>Event Type:</label>
    <select name="eventTypeID">
        <option value="">-- All Event Types --</option>

        @foreach (var type in (IEnumerable<EventEase.Models.EventType>)ViewData["EventTypes"])
        {
            <option value="@type.EventTypeID">@type.Name</option>
        }
    </select>

    <!-- Venue -->
    <label>Venue:</label>
    <select name="venueID">
        <option value="">-- All Venues --</option>

        @foreach (var venue in (IEnumerable<EventEase.Models.Venue>)ViewData["Venues"])
        {
            <option value="@venue.VenueID">@venue.VenueName</option>
        }
    </select>

    <label>Start Date:</label>
    <input type="date" name="startDate" value="@Context.Request.Query["startDate"]" />

    <label>End Date:</label>
    <input type="date" name="endDate" value="@Context.Request.Query["endDate"]" />

    <label>
        <input type="checkbox" name="availableOnly" value="true" />
        Available Only
    </label>

    <button type="submit" class="btn-azure">Filter</button>

    <a asp-action="Index" class="btn-azure">Clear</a>
</form>

<p>
    <a asp-action="Create" class="btn-azure">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Event ID</th>
            <th>Event Name</th>
            <th>Event Date</th>
            <th>Description</th>
            <th>Event Type</th>
            <th>Venue</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EventID</td>
                <td>@item.EventName</td>
                <td>@item.EventDate</td>
                <td>@item.Description</td>

                
                <td>@(item.EventType?.Name ?? "No Event Type")</td>
                <td>@(item.Venue?.VenueName ?? "No Venue")</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.EventID" class="btn-azure">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.EventID" class="btn-azure">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.EventID" class="btn-azure">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>